<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.gouv.dsfr</groupId>
        <artifactId>dsfr-faces-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dsfr-faces-resources</artifactId>
    <name>dsfr-faces :: resources</name>
    <description>
        DSFR dist/ packaged under META-INF/resources/dsfr. Any Servlet 3.0+ container serves this
        statically at /{context}/dsfr/..., so the relative url(...) references to fonts and icons
        inside the DSFR CSS keep working (the Faces resource handler would break them).
        The DSFR is fetched from npm during the build (package.json / package-lock.json in this module).
    </description>

    <properties>
        <dsfr.dist>${project.basedir}/node_modules/@gouvfr/dsfr/dist</dsfr.dist>
    </properties>

    <build>
        <plugins>
            <!--
                generate-resources: downloads Node + npm (cached in the local Maven repository,
                unpacked into target/), then "npm ci" in this module.
                The DSFR preinstall script checks licence acceptance: DSFR_ACCEPT_LICENSE=1 makes it
                pass in every build (CI included), without depending on the .dsfr.yml consent file
                (kept for manual "npm ci" runs in this directory).
                Skip with -Dskip.installnodenpm -Dskip.npm (node_modules/ must then already exist).
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <environmentVariables>
                        <DSFR_ACCEPT_LICENSE>1</DSFR_ACCEPT_LICENSE>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <arguments>ci --no-audit --no-fund --update-notifier=false</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Same phase as the npm execution, declared after it, so it runs once npm is done -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-dsfr-dist</id>
                        <phase>generate-resources</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${dsfr.dist}/dsfr.min.css</file>
                                    </files>
                                    <message>DSFR dist not found after "npm ci" (or npm was skipped without an existing node_modules/).</message>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dsfr-dist</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources/dsfr</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${dsfr.dist}</directory>
                                    <!-- Never filter: fonts and images are binary -->
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>**/*.map</exclude>
                                        <exclude>**/README.md</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
