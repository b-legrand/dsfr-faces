<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.gouv.dsfr</groupId>
        <artifactId>dsfr-faces-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dsfr-faces-showcase</artifactId>
    <packaging>war</packaging>
    <name>dsfr-faces :: showcase</name>
    <description>
        Portable WAR: no server-specific descriptor or plugin. Deploy it on any Jakarta EE 11 (Web Profile)
        runtime, or on a servlet container that bundles Faces 4.1 + CDI.
    </description>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.gouv.dsfr</groupId>
            <artifactId>dsfr-faces-core</artifactId>
        </dependency>
        <!-- Optional migration tool, run on src/main/richfaces-fields at build time (not packaged) -->
        <dependency>
            <groupId>fr.gouv.dsfr</groupId>
            <artifactId>dsfr-faces-migrate</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Replaces the RichFaces jars for the migrated page under /richfaces/ -->
        <dependency>
            <groupId>fr.gouv.dsfr</groupId>
            <artifactId>dsfr-faces-richfaces-compat</artifactId>
        </dependency>
    </dependencies>

    <properties>
        <richfaces.migrated>${project.build.directory}/richfaces-migrated</richfaces.migrated>
        <richfaces.fields>${project.build.directory}/richfaces-fields-migrated</richfaces.fields>
    </properties>

    <build>
        <finalName>dsfr-faces-showcase</finalName>
        <plugins>
            <!--
                Migration demos, on original RichFaces pages (never edited by hand):
                - mandatory path: src/main/richfaces -> sed (scripts/migrate-richfaces.sh, GNU sed) -> /richfaces/
                - optional path: src/main/richfaces-fields -> sed -> dsfr-faces-migrate (dsfr:field) -> /richfaces-fields/
                Skip with -Dexec.skip (the pages are then served unmigrated and fail).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-richfaces-pages</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${richfaces.migrated}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/richfaces</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-richfaces-fields-pages</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${richfaces.fields}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/richfaces-fields</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>migrate-richfaces-pages</id>
                        <phase>process-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/migrate-richfaces.sh</argument>
                                <argument>${richfaces.migrated}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>migrate-richfaces-fields-sed</id>
                        <phase>process-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/migrate-richfaces.sh</argument>
                                <argument>${richfaces.fields}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- declared after the sed: same phase, runs next -->
                    <execution>
                        <id>migrate-richfaces-fields-tool</id>
                        <phase>process-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>${project.basedir}/../dsfr-faces-migrate/target/classes</argument>
                                <argument>fr.gouv.dsfr.faces.migrate.Main</argument>
                                <argument>${richfaces.fields}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webResources>
                        <resource>
                            <directory>${richfaces.migrated}</directory>
                            <targetPath>richfaces</targetPath>
                        </resource>
                        <resource>
                            <directory>${richfaces.fields}</directory>
                            <targetPath>richfaces-fields</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
