<?xml version="1.0" encoding="UTF-8"?>
<!--
    RichFaces "rich" tag library, served at the RichFaces URI so that pages migrated with
    sed 's/\<rich:/dsfr:/g' (xmlns:dsfr="http://richfaces.org/rich") resolve here.
    Tags map to dsfr-faces components. Undeclared RichFaces attributes are accepted and ignored.
-->
<facelet-taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facelettaglibrary_4_0.xsd"
                version="4.0">
    <description>dsfr-faces: RichFaces compatibility (rich:*)</description>
    <namespace>http://richfaces.org/rich</namespace>
    <short-name>rich</short-name>

    <!-- ================================================================ EL functions -->
    <function>
        <description>Client id of the component with this id (RichFaces lookup).</description>
        <function-name>clientId</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>java.lang.String clientId(java.lang.String)</function-signature>
    </function>
    <function>
        <description>JavaScript: RichFaces.component('clientId').</description>
        <function-name>component</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>java.lang.String component(java.lang.String)</function-signature>
    </function>
    <function>
        <description>JavaScript: document.getElementById('clientId').</description>
        <function-name>element</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>java.lang.String element(java.lang.String)</function-signature>
    </function>
    <function>
        <description>The UIComponent with this id (RichFaces lookup).</description>
        <function-name>findComponent</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>jakarta.faces.component.UIComponent findComponent(java.lang.String)</function-signature>
    </function>
    <function>
        <description>True if the user has one of the roles (collection or comma separated string).</description>
        <function-name>isUserInRole</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>boolean isUserInRole(java.lang.Object)</function-signature>
    </function>
    <function>
        <description>CSS selector #clientId, escaped for a JavaScript string.</description>
        <function-name>jQuerySelector</function-name>
        <function-class>fr.gouv.dsfr.faces.richfaces.RichFunctions</function-class>
        <function-signature>java.lang.String jQuerySelector(java.lang.String)</function-signature>
    </function>

    <!-- ================================================================ messages -->
    <tag>
        <description>rich:messages as DSFR alerts (dsfr:messages). ajaxRendered by default.</description>
        <tag-name>messages</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Messages</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>globalOnly</name><type>boolean</type></attribute>
        <attribute><name>for</name><type>java.lang.String</type></attribute>
        <attribute><name>showSummary</name><type>boolean</type></attribute>
        <attribute><name>showDetail</name><type>boolean</type></attribute>
        <attribute><name>ajaxRendered</name><type>boolean</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ message -->
    <tag>
        <description>rich:message as DSFR inline messages (dsfr:message). ajaxRendered by default.</description>
        <tag-name>message</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Message</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>for</name><required>true</required><type>java.lang.String</type></attribute>
        <attribute><name>ajaxRendered</name><type>boolean</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ field -->
    <tag>
        <description>dsfr-faces extension (not RichFaces), added by the optional migration tool: DSFR field group (fr-input-group / fr-select-group) around existing standard components (h:outputLabel, h:inputText, h:selectOneMenu, h:message / rich:message), without changing their ids. Error state from the field; with dsfr-faces-html: required mark and hint in the label, aria-required / aria-describedby on the field. Re-rendered by ajax requests that execute its field.</description>
        <tag-name>field</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Field</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute>
            <description>Additional description rendered in the label (fr-hint-text). Needs dsfr-faces-html.</description>
            <name>hint</name><type>java.lang.String</type>
        </attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ dataTable -->
    <tag>
        <description>rich:dataTable as dsfr:dataTable. DSFR table (fr-table). Replaces rich:dataTable / h:dataTable. Facets caption (or header), noData.</description>
        <tag-name>dataTable</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.DataTable</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>value</name><type>java.lang.Object</type></attribute>
        <attribute><name>var</name><type>java.lang.String</type></attribute>
        <attribute><description>Rows per page (with dataScroller).</description><name>rows</name><type>int</type></attribute>
        <attribute><name>first</name><type>int</type></attribute>
        <attribute><name>rowStatePreserved</name><type>boolean</type></attribute>
        <attribute><name>caption</name><type>java.lang.String</type></attribute>
        <attribute><description>sm, md, lg.</description><name>size</name><type>java.lang.String</type></attribute>
        <attribute><name>bordered</name><type>boolean</type></attribute>
        <attribute><name>noScroll</name><type>boolean</type></attribute>
        <attribute><description>Comma separated, cycled.</description><name>rowClasses</name><type>java.lang.String</type></attribute>
        <attribute><name>columnClasses</name><type>java.lang.String</type></attribute>
        <attribute><name>noDataLabel</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ column -->
    <tag>
        <description>rich:column as dsfr:column. Column of a dataTable. Facets header, footer. sortBy: sortable column.</description>
        <tag-name>column</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Column</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><description>Value sorted on (expression using the table var).</description><name>sortBy</name><type>java.lang.Object</type></attribute>
        <attribute><description>ascending, descending or unsorted (String or enum).</description><name>sortOrder</name><type>java.lang.Object</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><name>headerClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ dataScroller -->
    <tag>
        <description>rich:dataScroller as dsfr:dataScroller. DSFR pagination (fr-pagination) of a dataTable with rows, ajax page changes.</description>
        <tag-name>dataScroller</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.DataScroller</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><description>Id of the table (RichFaces lookup).</description><name>for</name><type>java.lang.String</type></attribute>
        <attribute><description>Default 10.</description><name>maxPages</name><type>int</type></attribute>
        <attribute><description>show (default) or hide.</description><name>boundaryControls</name><type>java.lang.String</type></attribute>
        <attribute><description>show (default) or hide.</description><name>stepControls</name><type>java.lang.String</type></attribute>
        <attribute><description>Current page (written back).</description><name>page</name><type>java.lang.Integer</type></attribute>
    </tag>

    <!-- ================================================================ panel -->
    <tag>
        <description>rich:panel as dsfr:panel. Content box with a title, rendered as a DSFR card without link (fr-card fr-card--no-arrow). Replaces rich:panel. Facet header.</description>
        <tag-name>panel</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Panel</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>header</name><type>java.lang.String</type></attribute>
        <attribute><description>h2..h6, default h3.</description><name>headerTag</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><name>bodyClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ collapsiblePanel -->
    <tag>
        <description>rich:collapsiblePanel as dsfr:collapsiblePanel. A single DSFR accordion; the state is kept across requests. Replaces rich:collapsiblePanel (client switching). Facet header.</description>
        <tag-name>collapsiblePanel</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.CollapsiblePanel</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>header</name><type>java.lang.String</type></attribute>
        <attribute><description>Written back to its expression.</description><name>expanded</name><type>boolean</type></attribute>
        <attribute><description>Default h3.</description><name>headingTag</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><description>Only client switching is supported.</description><name>switchType</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ accordion -->
    <tag>
        <description>rich:accordion as dsfr:accordion. Group of accordion items (fr-accordions-group), one open at a time; the open item is kept across requests. Replaces rich:accordion (client switching).</description>
        <tag-name>accordion</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Accordion</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><description>Name of the open item (written back to its expression).</description><name>activeItem</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><description>Only client switching is supported.</description><name>switchType</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ accordionItem -->
    <tag>
        <description>rich:accordionItem as dsfr:accordionItem. One accordion (fr-accordion). Facet header.</description>
        <tag-name>accordionItem</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.AccordionItem</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>header</name><type>java.lang.String</type></attribute>
        <attribute><description>Default: the id.</description><name>name</name><type>java.lang.String</type></attribute>
        <attribute><description>Default h3.</description><name>headingTag</name><type>java.lang.String</type></attribute>
        <attribute><name>disabled</name><type>boolean</type></attribute>
    </tag>

    <!-- ================================================================ tabPanel -->
    <tag>
        <description>rich:tabPanel as dsfr:tabPanel. DSFR tabs (fr-tabs). switchType ajax (default, as RichFaces: only the active tab is rendered and processed), server, or client (every tab rendered and processed).</description>
        <tag-name>tabPanel</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.TabPanel</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><description>Name of the active tab (written back to its expression).</description><name>activeItem</name><type>java.lang.String</type></attribute>
        <attribute><description>ajax (default), server, client.</description><name>switchType</name><type>java.lang.String</type></attribute>
        <attribute><description>aria-label of the tab list. Default « Onglets ».</description><name>label</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ tab -->
    <tag>
        <description>rich:tab as dsfr:tab. One tab of a tabPanel. Facet header.</description>
        <tag-name>tab</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Tab</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>header</name><type>java.lang.String</type></attribute>
        <attribute><description>Default: the id.</description><name>name</name><type>java.lang.String</type></attribute>
        <attribute><description>DSFR icon class.</description><name>icon</name><type>java.lang.String</type></attribute>
        <attribute><name>disabled</name><type>boolean</type></attribute>
    </tag>

    <!-- ================================================================ popupPanel -->
    <tag>
        <description>rich:popupPanel as dsfr:popupPanel. DSFR modal (dialog.fr-modal). Replaces rich:popupPanel. Opened with DsfrFaces.component(id).show() / #{rich:component('id')}.show(), or show=true. Facet header.</description>
        <tag-name>popupPanel</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.PopupPanel</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>header</name><type>java.lang.String</type></attribute>
        <attribute><description>Default h1.</description><name>titleTag</name><type>java.lang.String</type></attribute>
        <attribute><description>Open when rendered.</description><name>show</name><type>boolean</type></attribute>
        <attribute><description>sm, md (default), lg.</description><name>size</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><description>Ignored: a DSFR modal is always modal.</description><name>modal</name><type>boolean</type></attribute>
        <attribute><description>Ignored.</description><name>autosized</name><type>boolean</type></attribute>
        <attribute><description>Ignored: see size.</description><name>width</name><type>int</type></attribute>
        <attribute><description>Ignored.</description><name>height</name><type>int</type></attribute>
        <attribute><description>Ignored.</description><name>domElementAttachment</name><type>java.lang.String</type></attribute>
    </tag>

    <!-- ================================================================ calendar -->
    <tag>
        <description>rich:calendar as dsfr:calendar. Native date field (input type=date). Replaces rich:calendar. yyyy-MM-dd converted to the value type: LocalDate, LocalDateTime, java.util.Date or String (datePattern).</description>
        <tag-name>calendar</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.Calendar</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>value</name><type>java.lang.Object</type></attribute>
        <attribute><name>required</name><type>boolean</type></attribute>
        <attribute><name>requiredMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>converterMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>validatorMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>converter</name><type>jakarta.faces.convert.Converter</type></attribute>
        <attribute><name>validator</name><type>jakarta.el.MethodExpression</type></attribute>
        <attribute><name>valueChangeListener</name><type>jakarta.el.MethodExpression</type></attribute>
        <attribute><name>immediate</name><type>boolean</type></attribute>
        <attribute><description>Label. With a label: complete DSFR group (the wrapper carries the client id, the control is {id}-input). Without: bare control carrying the client id, for an existing h:outputLabel for=, h:message or dsfr:field.</description><name>label</name><type>java.lang.String</type></attribute>
        <attribute><description>Additional description in the label (fr-hint-text).</description><name>hint</name><type>java.lang.String</type></attribute>
        <attribute><name>disabled</name><type>boolean</type></attribute>
        <attribute><name>readonly</name><type>boolean</type></attribute>
        <attribute><name>title</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><description>yyyy-MM-dd</description><name>min</name><type>java.lang.String</type></attribute>
        <attribute><description>yyyy-MM-dd</description><name>max</name><type>java.lang.String</type></attribute>
        <attribute><description>Pattern of a String value (the browser always submits yyyy-MM-dd).</description><name>datePattern</name><type>java.lang.String</type></attribute>
        <attribute><description>Zone of a java.util.Date value. Default: server zone.</description><name>timeZone</name><type>java.lang.Object</type></attribute>
        <attribute><description>Ignored (native date field).</description><name>popup</name><type>boolean</type></attribute>
        <attribute><description>Ignored.</description><name>enableManualInput</name><type>boolean</type></attribute>
        <attribute><description>Ignored: the browser displays the date in its locale.</description><name>locale</name><type>java.lang.Object</type></attribute>
    </tag>

    <!-- ================================================================ select -->
    <tag>
        <description>rich:select as dsfr:selectOneMenu. DSFR drop-down list (fr-select). Children: f:selectItem, f:selectItems.</description>
        <tag-name>select</tag-name>
        <component>
            <component-type>fr.gouv.dsfr.SelectOneMenu</component-type>
        </component>
        <attribute><name>id</name><type>java.lang.String</type></attribute>
        <attribute><name>rendered</name><type>boolean</type></attribute>
        <attribute><name>binding</name><type>jakarta.faces.component.UIComponent</type></attribute>
        <attribute><name>value</name><type>java.lang.Object</type></attribute>
        <attribute><name>required</name><type>boolean</type></attribute>
        <attribute><name>requiredMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>converterMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>validatorMessage</name><type>java.lang.String</type></attribute>
        <attribute><name>converter</name><type>jakarta.faces.convert.Converter</type></attribute>
        <attribute><name>validator</name><type>jakarta.el.MethodExpression</type></attribute>
        <attribute><name>valueChangeListener</name><type>jakarta.el.MethodExpression</type></attribute>
        <attribute><name>immediate</name><type>boolean</type></attribute>
        <attribute><description>Label. With a label: complete DSFR group (the wrapper carries the client id, the control is {id}-input). Without: bare control carrying the client id, for an existing h:outputLabel for=, h:message or dsfr:field.</description><name>label</name><type>java.lang.String</type></attribute>
        <attribute><description>Additional description in the label (fr-hint-text).</description><name>hint</name><type>java.lang.String</type></attribute>
        <attribute><name>disabled</name><type>boolean</type></attribute>
        <attribute><name>readonly</name><type>boolean</type></attribute>
        <attribute><name>title</name><type>java.lang.String</type></attribute>
        <attribute><name>styleClass</name><type>java.lang.String</type></attribute>
        <attribute><description>First empty option (disabled if required).</description><name>placeholder</name><type>java.lang.String</type></attribute>
        <attribute><description>Placeholder (first empty option).</description><name>defaultLabel</name><type>java.lang.String</type></attribute>
        <attribute><description>Ignored (native list).</description><name>enableManualInput</name><type>boolean</type></attribute>
    </tag>
</facelet-taglib>
